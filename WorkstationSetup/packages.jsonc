{
  // ==============================================================================
  // Windows Workstation Package Catalog
  // Primary installer: WinGet | Secondary fallback: Chocolatey
  // Set "enabled": false to skip any package during installation.
  // ==============================================================================

  // 1. Web Browsers
  "browsers": [
    { "name": "Google Chrome", "winget": "Google.Chrome", "choco": "googlechrome", "pin": true },
    { "name": "Zen Browser", "winget": "Zen-Team.Zen-Browser", "choco": "zen-browser", "pin": true }
  ],

  // 2. Communication Software
  "communications": [
    { "name": "Discord", "winget": "Discord.Discord", "choco": "discord", "pin": true },
    { "name": "Zoom", "winget": "Zoom.Zoom", "choco": "zoom", "pin": true },
    { "name": "Slack", "winget": "SlackTechnologies.Slack", "choco": "slack", "pin": true },
    { "name": "Skype", "winget": "Microsoft.Skype", "choco": "skype" },
    { "name": "OBS Studio", "winget": "OBSProject.OBSStudio", "choco": "obs-studio" }
  ],

  // 3. Developer Editors, Git & Version Control
  "devEditorsAndGit": [
    { "name": "Visual Studio Code", "winget": "Microsoft.VisualStudioCode", "choco": "vscode", "pin": true },
    { "name": "Git", "winget": "Git.Git", "choco": "git" },
    { "name": "Git LFS", "winget": "GitHub.GitLFS", "choco": "git-lfs.install" },
    { "name": "GitHub CLI", "winget": "GitHub.cli", "choco": "gh" }
  ],

  // 4. Terminal Customization & Fonts
  "terminalAndFonts": [
    { "name": "Cascadia Code Nerd Font", "winget": "DEVCOM.CascadiaCodeNF", "choco": "nerd-fonts-cascadiacode" },
    { "name": "JetBrains Mono Nerd Font", "winget": "DEVCOM.JetBrainsMonoNF", "choco": "jetbrainsmononf" },
    { "name": "Oh My Posh", "winget": "JanDeDobbeleer.OhMyPosh", "choco": "oh-my-posh" }
  ],

  // Native PowerShell modules from PSGallery
  "psModules": [
    "posh-git",
    "Terminal-Icons",
    "psake"
  ],

  // 5. General Software Development
  "generalDev": [
    { "name": "LogExpert", "winget": "LogExpert.LogExpert", "choco": "logexpert" }
  ],

  // 6. C# / .NET & Azure Cloud Development
  "dotnetAndCloud": [
    { "name": "JetBrains Toolbox", "winget": "JetBrains.Toolbox", "choco": "jetbrainstoolbox", "pin": true },
    { "name": "Azure CLI", "winget": "Microsoft.AzureCLI", "choco": "azure-cli" },
    { "name": "Azure Data Studio", "winget": "Microsoft.AzureDataStudio", "choco": "azure-data-studio", "pin": true }
  ],

  // 7. Data Analysis & Runtimes
  "runtimesAndData": [
